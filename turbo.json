{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": ["NEXT_PUBLIC_DISABLE_DARK_MODE"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NEXT_PUBLIC_DISABLE_DARK_MODE",
        "APP_*",
        "API_URL",
        "DATABASE_*",
        "EMBEDDING_*",
        "AI_*",
        "ADMIN_*",
        "SESSION_SECRET",
        "RATE_LIMIT_REQUESTS_PER_MINUTE",
        "LOG_LEVEL"
      ]
    },
    "test": {
      "dependsOn": [
        "^test"
      ],
      "outputs": [],
      "passThroughEnv": [
        "TEST_DATABASE_URL"
      ]
    },
    "e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "passThroughEnv": [
        "NEXT_PUBLIC_DISABLE_DARK_MODE",
        "APP_*",
        "API_URL",
        "DATABASE_*",
        "EMBEDDING_*",
        "AI_*",
        "ADMIN_*",
        "SESSION_SECRET",
        "RATE_LIMIT_REQUESTS_PER_MINUTE",
        "LOG_LEVEL",
        "CI",
        "PLAYWRIGHT_BASE_URL"
      ]
    }
  }
}

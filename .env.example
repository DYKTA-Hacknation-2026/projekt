# ---------------------------------------------------------------------------
# Local development defaults. Copy to .env and change anything you need.
# NEVER commit a real .env file or production secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Zasiłkowy Przewodnik
APP_URL=http://localhost:3000

# PostgreSQL + pgvector (one database for app data, legal rules and vectors).
DATABASE_URL=postgresql://zpr:zpr_local_password@localhost:5435/zpr
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Embedding model contract, shared by ingestion (kb:seed) and retrieval.
# Every configuration gets its own kb.embedding_models row and partial HNSW
# index, so vectors are never mixed. After a change run `pnpm kb:seed` (or
# `pnpm --filter @zpr/rag kb:reembed`) before serving queries.
#   local-demo         deterministic offline hashing model (no API key)
#   openai             EMBEDDING_API_KEY, e.g. text-embedding-3-small / 1536
#   ollama             EMBEDDING_BASE_URL=http://localhost:11434/v1, e.g. bge-m3 / 1024
#   openai-compatible  any OpenAI-style /embeddings endpoint (vLLM, TEI, LiteLLM)
EMBEDDING_PROVIDER=local-demo
EMBEDDING_MODEL=zpr-hash-1024
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Asymmetric models (e5) need instruction prefixes; both sides must match.
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_DOCUMENT_PREFIX="passage: "
EMBEDDING_BATCH_SIZE=64

# Knowledge base. RESTRICTED sources (ZUS sample cases) are never indexed.
# PUBLIC for a public deployment; PUBLIC,INTERNAL lets the HackNation demo
# use the competition PDFs (cited, never quoted).
KB_RETRIEVAL_ACCESS_LEVELS=PUBLIC,INTERNAL
# Competition PDFs and other non-redistributable files (git-ignored).
# KB_LOCAL_SOURCES_DIR=./fixtures/private/sources

# Chunking and ranking (defaults shown). See docs/knowledge-sources.md.
# KB_CHUNK_MAX_TOKENS=450
# KB_CHUNK_MIN_TOKENS=60
# KB_CHUNK_OVERLAP_TOKENS=60
# KB_LEGAL_ARTICLE_MAX_TOKENS=350
# RETRIEVAL_FUSION=rrf            # rrf | weighted
# RETRIEVAL_RRF_K=60
# RETRIEVAL_MIN_RELEVANCE=0.3
# RETRIEVAL_RERANKER=none         # none | lexical

# Integration tests create and drop their own databases on this server.
# TEST_DATABASE_URL=postgresql://zpr:zpr_local_password@localhost:5435/zpr

# AI is optional in the scaffold. The assistant works without a provider by
# using deterministic retrieval and labelled demo answers.
AI_PROVIDER=none
# AI_MODEL=claude-sonnet-5-5
# AI_API_KEY=
# AI_BASE_URL=

# 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-32-chars
ADMIN_EMAIL=admin@zpr.local
ADMIN_DEMO_PASSWORD=demo-admin
ADMIN_GATE_ENABLED=false

RATE_LIMIT_REQUESTS_PER_MINUTE=60
LOG_LEVEL=info

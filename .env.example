# ---------------------------------------------------------------------------
# Local development defaults. Copy to .env and change anything you need.
# NEVER commit a real .env file or production secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Zasiłkowy Przewodnik
APP_URL=http://localhost:3000
# Web server only. The API listens on loopback port 3001 during local development.
API_URL=http://127.0.0.1:3001

# PostgreSQL + pgvector (one database for app data, legal rules and vectors).
DATABASE_URL=postgresql://zpr:zpr_local_password@localhost:5435/zpr
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Embedding model contract. Changing the model or dimensions requires a full
# re-embedding run and a new HNSW index; never mix incompatible vectors.
EMBEDDING_PROVIDER=local-demo
EMBEDDING_MODEL=zpr-hash-1024
EMBEDDING_DIMENSIONS=1024

# AI is optional in the scaffold. The assistant works without a provider by
# using deterministic retrieval and labelled demo answers.
AI_PROVIDER=none
# AI_MODEL=claude-sonnet-5-5
# AI_API_KEY=
# AI_BASE_URL=

# Share SESSION_SECRET and ADMIN_GATE_ENABLED between apps/web and apps/api.
# 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-32-chars
ADMIN_EMAIL=admin@zpr.local
ADMIN_DEMO_PASSWORD=demo-admin
ADMIN_GATE_ENABLED=false

RATE_LIMIT_REQUESTS_PER_MINUTE=60
LOG_LEVEL=info
